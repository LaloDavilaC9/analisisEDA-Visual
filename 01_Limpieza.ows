		<properties node_id="9" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import re\nimport unicodedata\nfrom difflib import SequenceMatcher\n\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\n# Solo afecta a la columna "Producto más parecido (referencia)": es la\n# proporción mínima de palabras del título de Ventas que tienen que aparecer\n# en una publicación ignorada para sugerirlo. No cambia qué publicaciones se\n# asocian ni el resultado de ningún análisis.\nUMBRAL_PARECIDO = 0.8\n# =======================================================================\n\n# Recibe dos tablas: las ventas limpias y las publicaciones de X (ya con su\n# hora). Da igual en qué orden se conecten, cada una se reconoce por una\n# columna que solo ella tiene.\n#\n# Cómo se decide si una publicación habla de un producto:\n#   - El texto del post debe contener el "Product Title" completo, como\n#     palabras enteras. Solo se ignoran las mayúsculas y los espacios o\n#     saltos de línea repetidos. Por ejemplo, "ZENTRATM" no cuenta como "ZENTRA".\n#   - Si un título está dentro de otro ("Licuadora Pro X" y "Licuadora Pro"),\n#     se busca primero el más largo y ese pedazo de texto ya no se vuelve a\n#     usar para el más corto.\n#   - Si dos filas de Ventas tienen el mismo título, no hay manera de saber a\n#     cuál se refiere la publicación, así que se ignora y se anota el motivo.\n#   - Todo lo demás queda como "Ignorada": se conserva solo de referencia y\n#     no entra al análisis.\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nposts = next((t for t in tablas if "Texto del post" in nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\n\nif ventas is None or posts is None:\n    raise ValueError(\n        "Conecta las dos tablas: la de Ventas (con \'Product Title\') y "\n        "la de Publicaciones de X (con \'Texto del post\')."\n    )\n\ndf_ventas = table_to_frame(ventas, include_metas=True)\ndf_posts = table_to_frame(posts, include_metas=True)\n\n# Las columnas discretas se pasan a texto para trabajar con ellas. Guardo su\n# orden (por ejemplo Lunes..Domingo) para devolverlas ordenadas al final.\nORDEN_CATEGORIAS = {}\nfor df_ in (df_ventas, df_posts):\n    for col in df_.columns:\n        if str(df_[col].dtype) == "category":\n            if df_ is df_posts:\n                ORDEN_CATEGORIAS[col] = list(df_[col].cat.categories)\n            df_[col] = df_[col].astype(object)\n\nya_traidas = [c for c in ("Product Title", "Estado", "Motivo") if c in df_posts.columns]\nif ya_traidas:\n    raise ValueError(f"La tabla de publicaciones ya trae las columnas {ya_traidas}. "\n                     f"Conecta la salida de \'PUB-04 Hora y franja de publicación\', no la de este widget.")\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\ndef forma_literal(texto):\n    """Pasa a minúsculas y deja un solo espacio donde haya varios espacios o\n    saltos de línea. No cambia nada más: acentos, guiones, \'TM\', etc. se quedan."""\n    return re.sub(r"\\s+", " ", str(texto).lower()).strip()\n\n\n# Los registros "genéricos" (enlaces a la tienda, sin un producto puntual) no\n# son un producto real, así que se quitan de aquí.\nif "es_generico" in df_ventas.columns:\n    df_ventas = df_ventas[~df_ventas["es_generico"].apply(es_verdadero)]\n\n# clave literal -&gt; [título original, cuántas filas de Ventas tienen ese título]\nregistros = {}\nfor titulo in df_ventas["Product Title"].dropna().astype(str):\n    titulo = titulo.strip()\n    clave = forma_literal(titulo)\n    if es_valor_centinela(titulo) or not clave:\n        continue\n    if clave in registros:\n        registros[clave][1] += 1\n    else:\n        registros[clave] = [titulo, 1]\n\nrepetidas = {k for k, (_, n) in registros.items() if n &gt; 1}\ntitulo_de = {k: v[0] for k, v in registros.items()}\n\n# Del título más largo al más corto, para que uno que está contenido en otro\n# no le quite las publicaciones al más específico.\nclaves_por_largo = sorted(registros, key=len, reverse=True)\npatrones = {k: re.compile(r"(?&lt;!\\w)" + re.escape(k) + r"(?!\\w)") for k in claves_por_largo}\n\n\ndef claves_en_texto(texto):\n    restante = forma_literal(texto)\n    halladas = []\n    for k in claves_por_largo:\n        if k in restante and patrones[k].search(restante):\n            halladas.append(k)\n            restante = patrones[k].sub("\\x00", restante)  # ese pedazo ya no se vuelve a usar\n    return halladas\n\n\ntextos = df_posts["Texto del post"].apply(lambda v: "" if pd.isna(v) else str(v))\nhalladas = textos.apply(claves_en_texto)\n\n\ndef decidir(claves):\n    validas = [titulo_de[k] for k in claves if k not in repetidas]\n    if validas:\n        return validas, "Asociada", "Coincide con Ventas"\n    if claves:\n        return [], "Ignorada", "Título repetido en Ventas"\n    return [], "Ignorada", "Sin coincidencia"\n\n\ndecisiones = [decidir(c) for c in halladas]\ndf_posts["Product Title"] = [d[0] for d in decisiones]\ndf_posts["Estado"] = [d[1] for d in decisiones]\ndf_posts["Motivo"] = [d[2] for d in decisiones]\n\n# ---------------------------------------------------------------------------\n# Columna de referencia para las ignoradas: qué título de Ventas se les parece\n# más. Aguanta "TM", acentos, guiones, "modelo2" y erratas ("LICUADROA"). No\n# se usa para asociar nada; solo sirve para ver si una ignorada tiene el nombre\n# mutilado o es un producto que no está en Ventas.\n# ---------------------------------------------------------------------------\n\n\ndef palabras(texto):\n    s = unicodedata.normalize("NFKD", str(texto)).encode("ascii", "ignore").decode().lower()\n    s = re.sub(r"([a-z])tm\\b", r"\\1", s)\n    s = re.sub(r"([a-z])(\\d)", r"\\1 \\2", s)\n    s = re.sub(r"(\\d)([a-z])", r"\\1 \\2", s)\n    return re.sub(r"[^a-z0-9]+", " ", s).split()\n\n\nes_ignorada = df_posts["Estado"] == "Ignorada"\npalabras_post = {i: set(palabras(textos[i])) for i in df_posts.index[es_ignorada]}\nvocabulario = set().union(*palabras_post.values()) if palabras_post else set()\npalabras_titulo = {k: list(dict.fromkeys(palabras(titulo_de[k]))) for k in registros}\n_equiv = {}\n\n\ndef equivalentes(w):\n    """Palabras del vocabulario que cuentan como la misma que w (idéntica o con una errata)."""\n    if w not in _equiv:\n        eq = {w} if w in vocabulario else set()\n        if len(w) &gt;= 5:\n            for v in vocabulario:\n                if (v != w and len(v) &gt;= 5 and v[0] == w[0] and abs(len(v) - len(w)) &lt;= 1\n                        and SequenceMatcher(None, w, v).ratio() &gt;= 0.8):\n                    eq.add(v)\n        _equiv[w] = eq\n    return _equiv[w]\n\n\ndef mas_parecido(pw):\n    mejor = None\n    for k, ws in palabras_titulo.items():\n        if not ws:\n            continue\n        aciertos = sum(1 for w in ws if equivalentes(w) &amp; pw)\n        cobertura = aciertos / len(ws)\n        if aciertos &gt;= 2 and cobertura &gt;= UMBRAL_PARECIDO:\n            clave = (cobertura, aciertos)   # con la misma cobertura gana el título más específico\n            if mejor is None or clave &gt; mejor[0]:\n                mejor = (clave, k)\n    return (titulo_de[mejor[1]], round(mejor[0][0], 2)) if mejor else ("", float("nan"))\n\n\n# Lo que no aplica se queda como valor faltante, no como texto vacío (Orange\n# lo tomaría como una categoría más).\ndf_posts["Producto más parecido (referencia)"] = pd.Series([None] * len(df_posts), dtype=object, index=df_posts.index)\ndf_posts["Parecido"] = float("nan")\nfor i, pw in palabras_post.items():\n    titulo, parecido = mas_parecido(pw)\n    if titulo:\n        df_posts.at[i, "Producto más parecido (referencia)"] = titulo\n        df_posts.at[i, "Parecido"] = parecido\n\n# ---------------------------------------------------------------------------\n# Resultado: una fila por cada par (publicación, producto) de las asociadas, y\n# una sola fila por cada publicación ignorada (con Product Title vacío).\n# ---------------------------------------------------------------------------\nasociadas = df_posts[df_posts["Estado"] == "Asociada"].explode("Product Title")\nignoradas = df_posts[df_posts["Estado"] == "Ignorada"].copy()\nignoradas["Product Title"] = None   # sin producto: valor faltante\nresultado = pd.concat([asociadas, ignoradas]).sort_index(kind="mergesort").reset_index(drop=True)\n\nfor col, categorias in ORDEN_CATEGORIAS.items():\n    resultado[col] = pd.Categorical(resultado[col], categories=categorias, ordered=True)\nresultado["Estado"] = pd.Categorical(resultado["Estado"], categories=["Asociada", "Ignorada"], ordered=True)\nresultado["Motivo"] = pd.Categorical(\n    resultado["Motivo"],\n    categories=["Coincide con Ventas", "Sin coincidencia", "Título repetido en Ventas"], ordered=True)\n\n# ------------------------------- Informe -----------------------------------\nn_posts = len(df_posts)\nn_asoc = int((df_posts["Estado"] == "Asociada").sum())\nn_sin = int((df_posts["Motivo"] == "Sin coincidencia").sum())\nn_rep = int((df_posts["Motivo"] == "Título repetido en Ventas").sum())\nn_multi = int((df_posts["Product Title"].apply(lambda x: isinstance(x, list) and len(x) &gt; 1)).sum())\nn_sugeridos = int(((df_posts["Estado"] == "Ignorada")\n                   &amp; df_posts["Producto más parecido (referencia)"].notna()).sum())\nproductos_con_posts = len(set(asociadas["Product Title"]))\n\n\ndef pct(n):\n    return f"{100 * n / n_posts:.1f} %" if n_posts else "-"\n\n\nprint(f"Ventas: {len(registros)} títulos válidos, {len(repetidas)} repetidos "\n      f"(sus publicaciones se ignoran).")\nfor k in sorted(repetidas)[:10]:\n    print(f"   repetido: {titulo_de[k]}")\nprint(f"Publicaciones: {n_posts}")\nprint(f"   asociadas a un registro de Ventas: {n_asoc} ({pct(n_asoc)}); "\n      f"{n_multi} mencionan más de un producto")\nprint(f"   ignoradas sin coincidencia:        {n_sin} ({pct(n_sin)})")\nprint(f"   ignoradas por título repetido:     {n_rep} ({pct(n_rep)})")\nprint(f"   de las ignoradas, con un producto \'parecido\' sugerido (solo referencia): {n_sugeridos}")\nprint(f"Registros de Ventas con al menos una publicación asociada: "\n      f"{productos_con_posts} de {len(registros)}")\n\nout_data = table_from_frame(resultado)\n', 'filename': None}], 'scriptText': 'import re\nimport unicodedata\nfrom difflib import SequenceMatcher\n\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\n# Solo afecta a la columna "Producto más parecido (referencia)": es la\n# proporción mínima de palabras del título de Ventas que tienen que aparecer\n# en una publicación ignorada para sugerirlo. No cambia qué publicaciones se\n# asocian ni el resultado de ningún análisis.\nUMBRAL_PARECIDO = 0.8\n# =======================================================================\n\n# Recibe dos tablas: las ventas limpias y las publicaciones de X (ya con su\n# hora). Da igual en qué orden se conecten, cada una se reconoce por una\n# columna que solo ella tiene.\n#\n# Cómo se decide si una publicación habla de un producto:\n#   - El texto del post debe contener el "Product Title" completo, como\n#     palabras enteras. Solo se ignoran las mayúsculas y los espacios o\n#     saltos de línea repetidos. Por ejemplo, "ZENTRATM" no cuenta como "ZENTRA".\n#   - Si un título está dentro de otro ("Licuadora Pro X" y "Licuadora Pro"),\n#     se busca primero el más largo y ese pedazo de texto ya no se vuelve a\n#     usar para el más corto.\n#   - Si dos filas de Ventas tienen el mismo título, no hay manera de saber a\n#     cuál se refiere la publicación, así que se ignora y se anota el motivo.\n#   - Todo lo demás queda como "Ignorada": se conserva solo de referencia y\n#     no entra al análisis.\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nposts = next((t for t in tablas if "Texto del post" in nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\n\nif ventas is None or posts is None:\n    raise ValueError(\n        "Conecta las dos tablas: la de Ventas (con \'Product Title\') y "\n        "la de Publicaciones de X (con \'Texto del post\')."\n    )\n\ndf_ventas = table_to_frame(ventas, include_metas=True)\ndf_posts = table_to_frame(posts, include_metas=True)\n\n# Las columnas discretas se pasan a texto para trabajar con ellas. Guardo su\n# orden (por ejemplo Lunes..Domingo) para devolverlas ordenadas al final.\nORDEN_CATEGORIAS = {}\nfor df_ in (df_ventas, df_posts):\n    for col in df_.columns:\n        if str(df_[col].dtype) == "category":\n            if df_ is df_posts:\n                ORDEN_CATEGORIAS[col] = list(df_[col].cat.categories)\n            df_[col] = df_[col].astype(object)\n\nya_traidas = [c for c in ("Product Title", "Estado", "Motivo") if c in df_posts.columns]\nif ya_traidas:\n    raise ValueError(f"La tabla de publicaciones ya trae las columnas {ya_traidas}. "\n                     f"Conecta la salida de \'PUB-04 Hora y franja de publicación\', no la de este widget.")\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\ndef forma_literal(texto):\n    """Pasa a minúsculas y deja un solo espacio donde haya varios espacios o\n    saltos de línea. No cambia nada más: acentos, guiones, \'TM\', etc. se quedan."""\n    return re.sub(r"\\s+", " ", str(texto).lower()).strip()\n\n\n# Los registros "genéricos" (enlaces a la tienda, sin un producto puntual) no\n# son un producto real, así que se quitan de aquí.\nif "es_generico" in df_ventas.columns:\n    df_ventas = df_ventas[~df_ventas["es_generico"].apply(es_verdadero)]\n\n# clave literal -&gt; [título original, cuántas filas de Ventas tienen ese título]\nregistros = {}\nfor titulo in df_ventas["Product Title"].dropna().astype(str):\n    titulo = titulo.strip()\n    clave = forma_literal(titulo)\n    if es_valor_centinela(titulo) or not clave:\n        continue\n    if clave in registros:\n        registros[clave][1] += 1\n    else:\n        registros[clave] = [titulo, 1]\n\nrepetidas = {k for k, (_, n) in registros.items() if n &gt; 1}\ntitulo_de = {k: v[0] for k, v in registros.items()}\n\n# Del título más largo al más corto, para que uno que está contenido en otro\n# no le quite las publicaciones al más específico.\nclaves_por_largo = sorted(registros, key=len, reverse=True)\npatrones = {k: re.compile(r"(?&lt;!\\w)" + re.escape(k) + r"(?!\\w)") for k in claves_por_largo}\n\n\ndef claves_en_texto(texto):\n    restante = forma_literal(texto)\n    halladas = []\n    for k in claves_por_largo:\n        if k in restante and patrones[k].search(restante):\n            halladas.append(k)\n            restante = patrones[k].sub("\\x00", restante)  # ese pedazo ya no se vuelve a usar\n    return halladas\n\n\ntextos = df_posts["Texto del post"].apply(lambda v: "" if pd.isna(v) else str(v))\nhalladas = textos.apply(claves_en_texto)\n\n\ndef decidir(claves):\n    validas = [titulo_de[k] for k in claves if k not in repetidas]\n    if validas:\n        return validas, "Asociada", "Coincide con Ventas"\n    if claves:\n        return [], "Ignorada", "Título repetido en Ventas"\n    return [], "Ignorada", "Sin coincidencia"\n\n\ndecisiones = [decidir(c) for c in halladas]\ndf_posts["Product Title"] = [d[0] for d in decisiones]\ndf_posts["Estado"] = [d[1] for d in decisiones]\ndf_posts["Motivo"] = [d[2] for d in decisiones]\n\n# ---------------------------------------------------------------------------\n# Columna de referencia para las ignoradas: qué título de Ventas se les parece\n# más. Aguanta "TM", acentos, guiones, "modelo2" y erratas ("LICUADROA"). No\n# se usa para asociar nada; solo sirve para ver si una ignorada tiene el nombre\n# mutilado o es un producto que no está en Ventas.\n# ---------------------------------------------------------------------------\n\n\ndef palabras(texto):\n    s = unicodedata.normalize("NFKD", str(texto)).encode("ascii", "ignore").decode().lower()\n    s = re.sub(r"([a-z])tm\\b", r"\\1", s)\n    s = re.sub(r"([a-z])(\\d)", r"\\1 \\2", s)\n    s = re.sub(r"(\\d)([a-z])", r"\\1 \\2", s)\n    return re.sub(r"[^a-z0-9]+", " ", s).split()\n\n\nes_ignorada = df_posts["Estado"] == "Ignorada"\npalabras_post = {i: set(palabras(textos[i])) for i in df_posts.index[es_ignorada]}\nvocabulario = set().union(*palabras_post.values()) if palabras_post else set()\npalabras_titulo = {k: list(dict.fromkeys(palabras(titulo_de[k]))) for k in registros}\n_equiv = {}\n\n\ndef equivalentes(w):\n    """Palabras del vocabulario que cuentan como la misma que w (idéntica o con una errata)."""\n    if w not in _equiv:\n        eq = {w} if w in vocabulario else set()\n        if len(w) &gt;= 5:\n            for v in vocabulario:\n                if (v != w and len(v) &gt;= 5 and v[0] == w[0] and abs(len(v) - len(w)) &lt;= 1\n                        and SequenceMatcher(None, w, v).ratio() &gt;= 0.8):\n                    eq.add(v)\n        _equiv[w] = eq\n    return _equiv[w]\n\n\ndef mas_parecido(pw):\n    mejor = None\n    for k, ws in palabras_titulo.items():\n        if not ws:\n            continue\n        aciertos = sum(1 for w in ws if equivalentes(w) &amp; pw)\n        cobertura = aciertos / len(ws)\n        if aciertos &gt;= 2 and cobertura &gt;= UMBRAL_PARECIDO:\n            clave = (cobertura, aciertos)   # con la misma cobertura gana el título más específico\n            if mejor is None or clave &gt; mejor[0]:\n                mejor = (clave, k)\n    return (titulo_de[mejor[1]], round(mejor[0][0], 2)) if mejor else ("", float("nan"))\n\n\n# Lo que no aplica se queda como valor faltante, no como texto vacío (Orange\n# lo tomaría como una categoría más).\ndf_posts["Producto más parecido (referencia)"] = pd.Series([None] * len(df_posts), dtype=object, index=df_posts.index)\ndf_posts["Parecido"] = float("nan")\nfor i, pw in palabras_post.items():\n    titulo, parecido = mas_parecido(pw)\n    if titulo:\n        df_posts.at[i, "Producto más parecido (referencia)"] = titulo\n        df_posts.at[i, "Parecido"] = parecido\n\n# ---------------------------------------------------------------------------\n# Resultado: una fila por cada par (publicación, producto) de las asociadas, y\n# una sola fila por cada publicación ignorada (con Product Title vacío).\n# ---------------------------------------------------------------------------\nasociadas = df_posts[df_posts["Estado"] == "Asociada"].explode("Product Title")\nignoradas = df_posts[df_posts["Estado"] == "Ignorada"].copy()\nignoradas["Product Title"] = None   # sin producto: valor faltante\nresultado = pd.concat([asociadas, ignoradas]).sort_index(kind="mergesort").reset_index(drop=True)\n\nfor col, categorias in ORDEN_CATEGORIAS.items():\n    resultado[col] = pd.Categorical(resultado[col], categories=categorias, ordered=True)\nresultado["Estado"] = pd.Categorical(resultado["Estado"], categories=["Asociada", "Ignorada"], ordered=True)\nresultado["Motivo"] = pd.Categorical(\n    resultado["Motivo"],\n    categories=["Coincide con Ventas", "Sin coincidencia", "Título repetido en Ventas"], ordered=True)\n\n# ------------------------------- Informe -----------------------------------\nn_posts = len(df_posts)\nn_asoc = int((df_posts["Estado"] == "Asociada").sum())\nn_sin = int((df_posts["Motivo"] == "Sin coincidencia").sum())\nn_rep = int((df_posts["Motivo"] == "Título repetido en Ventas").sum())\nn_multi = int((df_posts["Product Title"].apply(lambda x: isinstance(x, list) and len(x) &gt; 1)).sum())\nn_sugeridos = int(((df_posts["Estado"] == "Ignorada")\n                   &amp; df_posts["Producto más parecido (referencia)"].notna()).sum())\nproductos_con_posts = len(set(asociadas["Product Title"]))\n\n\ndef pct(n):\n    return f"{100 * n / n_posts:.1f} %" if n_posts else "-"\n\n\nprint(f"Ventas: {len(registros)} títulos válidos, {len(repetidas)} repetidos "\n      f"(sus publicaciones se ignoran).")\nfor k in sorted(repetidas)[:10]:\n    print(f"   repetido: {titulo_de[k]}")\nprint(f"Publicaciones: {n_posts}")\nprint(f"   asociadas a un registro de Ventas: {n_asoc} ({pct(n_asoc)}); "\n      f"{n_multi} mencionan más de un producto")\nprint(f"   ignoradas sin coincidencia:        {n_sin} ({pct(n_sin)})")\nprint(f"   ignoradas por título repetido:     {n_rep} ({pct(n_rep)})")\nprint(f"   de las ignoradas, con un producto \'parecido\' sugerido (solo referencia): {n_sugeridos}")\nprint(f"Registros de Ventas con al menos una publicación asociada: "\n      f"{productos_con_posts} de {len(registros)}")\n\nout_data = table_from_frame(resultado)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Recibe dos tablas: las ventas limpias y la salida de "INT-01 Asociar\n# publicaciones con productos". El orden en que se conecten da igual, cada una\n# se reconoce por columnas que solo ella tiene. Aquí no se busca ninguna\n# coincidencia: solo se resumen las publicaciones que el paso anterior marcó\n# como "Asociada".\n#\n# El resultado trae una fila por cada registro de Ventas (sin agrupar ni unir\n# filas), con sus datos de la tienda en línea tal cual y el resumen de sus publicaciones en\n# X. Lo único que se deja fuera son los registros "genéricos" (enlaces a la\n# tienda, sin un producto puntual).\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nasociadas = next((t for t in tablas\n                  if {"Estado", "Texto del post"} &lt;= nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\n\nif ventas is None or asociadas is None:\n    raise ValueError(\n        "Conecta las dos tablas: la de Ventas (con \'Product Title\') y la salida "\n        "de \'INT-01 Asociar publicaciones con productos\' (con \'Estado\')."\n    )\n\ndf_ventas = table_to_frame(ventas, include_metas=True)\ndf_posts = table_to_frame(asociadas, include_metas=True)\n\nfor df in (df_ventas, df_posts):\n    for col in df.columns:\n        if str(df[col].dtype) == "category":\n            df[col] = df[col].astype(object)\n\n# Al resumen solo entran las publicaciones asociadas; las ignoradas se quedan\n# fuera (están en la tabla de referencia del paso anterior). De las ignoradas\n# solo se aprovecha cuántas hay por "producto más parecido", como dato extra.\nn_ignoradas = int((df_posts["Estado"] != "Asociada").sum())\nposts_asoc = df_posts[df_posts["Estado"] == "Asociada"].copy()\nCOL_PARECIDO = "Producto más parecido (referencia)"\nif COL_PARECIDO in df_posts.columns:\n    parecidas_por_titulo = (\n        df_posts[(df_posts["Estado"] == "Ignorada") &amp; (df_posts["Motivo"] == "Sin coincidencia")]\n        [COL_PARECIDO].dropna().astype(str).str.strip().value_counts()\n    )\nelse:\n    parecidas_por_titulo = pd.Series(dtype=int)\nposts_asoc["Product Title"] = posts_asoc["Product Title"].astype(str).str.strip()\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\n# Los registros "genéricos" (enlaces a la tienda, sin un producto puntual) no\n# son un producto, así que no entran a un resumen por producto.\nn_filas_ventas = len(df_ventas)\nif "es_generico" in df_ventas.columns:\n    es_quitado = df_ventas["es_generico"].apply(es_verdadero)\n    motivo_quitado = "registro genérico (es_generico)"\nelse:\n    es_quitado = df_ventas["Product Title"].apply(es_valor_centinela)\n    motivo_quitado = "título vacío o sin valor"\nquitados = df_ventas[es_quitado]       # se listan en la consola al final\ndf_ventas = df_ventas[~es_quitado]\n\n# Cada fila de posts_asoc ya es un par (publicación, producto). Si una\n# publicación menciona dos productos sale en dos filas, y sus métricas cuentan\n# completas para cada uno. "Publicaciones compartidas con otro producto" dice\n# cuántas de las publicaciones de un producto están en ese caso.\ncol_id = "ID del post" if "ID del post" in posts_asoc.columns else "Texto del post"\nproductos_por_post = posts_asoc.groupby(col_id)["Product Title"].transform("nunique")\nposts_asoc["_compartida"] = (productos_por_post &gt; 1).astype(int)\n\nCOLUMNAS_X_A_SUMAR = [c for c in [\n    "Impresiones", "Me gusta", "Interacciones", "Guardados", "Compartidos",\n    "Nuevos seguidores", "Respuestas", "Reposts", "Clics en URL",\n] if c in posts_asoc.columns]\nfor col in COLUMNAS_X_A_SUMAR:\n    posts_asoc[col] = posts_asoc[col].apply(a_numero)\n\nagg_dict = {"N publicaciones": ("Product Title", "count")}\nfor col in COLUMNAS_X_A_SUMAR:\n    agg_dict[col] = (col, "sum")\nagg_dict["Publicaciones compartidas con otro producto"] = ("_compartida", "sum")\nresumen_x = posts_asoc.groupby("Product Title").agg(**agg_dict).reset_index()\n\nresumen_x = resumen_x.rename(columns={\n    "Impresiones": "Impresiones (X)", "Me gusta": "Me gusta (X)",\n    "Interacciones": "Interacciones (X)", "Clics en URL": "Clics en URL (X)",\n})\n\n# Columnas de Ventas que pasan al resumen. "Order Quantity" es la Frecuencia\n# (F) del análisis FM con K-Means; "datos_incompletos" sirve para excluir o\n# revisar los productos cuyos ceros no vienen de la fuente oficial.\nCOLUMNAS_VENTAS = [c for c in [\n    "Product Title", "Category", "Clicks", "Items Ordered", "Items Shipped",\n    "Order Quantity", "Items Returned", "Total Earnings", "datos_incompletos",\n] if c in df_ventas.columns]\nresumen_ventas = df_ventas[COLUMNAS_VENTAS].copy().rename(columns={"Clicks": "Clicks (ventas)"})\nresumen_ventas["Product Title"] = resumen_ventas["Product Title"].astype(str).str.strip()\n\n# Un título repetido en Ventas no recibe publicaciones: el paso anterior las\n# dejó ignoradas porque no se sabe a cuál de los registros se refieren.\nforma = resumen_ventas["Product Title"].str.lower().str.replace(r"\\s+", " ", regex=True).str.strip()\nrepetido = forma.duplicated(keep=False)\nn_repetidos = int(repetido.sum())\n\nresultado = resumen_ventas.merge(resumen_x, on="Product Title", how="left")\nfor col in resumen_x.columns:\n    if col != "Product Title":\n        resultado[col] = resultado[col].fillna(0.0)\nresultado["N publicaciones"] = resultado["N publicaciones"].astype(int)\nresultado["Publicaciones compartidas con otro producto"] = (\n    resultado["Publicaciones compartidas con otro producto"].astype(int))\n\nresultado["Título repetido en Ventas"] = pd.Categorical(\n    repetido.map({True: "Sí", False: "No"}).values, categories=["No", "Sí"], ordered=True)\n\n# Publicaciones ignoradas (sin coincidencia exacta) cuyo nombre se parece a\n# este producto, según la columna de referencia del paso anterior. Un producto\n# con 0 publicaciones exactas pero varias parecidas probablemente sí se\n# publicó con el nombre mutilado, y entonces su "N publicaciones" está de menos.\nresultado["Publicaciones ignoradas parecidas"] = (\n    resultado["Product Title"].map(parecidas_por_titulo).fillna(0).astype(int))\n\nresultado = resultado.sort_values("N publicaciones", ascending=False, kind="mergesort").reset_index(drop=True)\n\nsin_publicar = int((resultado["N publicaciones"] == 0).sum())\nsin_exactas_con_parecidas = int(((resultado["N publicaciones"] == 0)\n                                 &amp; (resultado["Publicaciones ignoradas parecidas"] &gt; 0)).sum())\nn_posts = int(posts_asoc[col_id].nunique())\nn_compartidas = int(posts_asoc.loc[posts_asoc["_compartida"] == 1, col_id].nunique())\nprint(f"Ventas recibidas: {n_filas_ventas} filas. Omitidas del resumen: {len(quitados)} "\n      f"({motivo_quitado}). En el resumen: {len(resultado)}.")\nif len(quitados):\n    columnas_mostrar = [c for c in ("ASIN", "Product Title", "Category", "Clicks", "Total Earnings")\n                        if c in quitados.columns]\n    for _, fila in quitados.head(30).iterrows():\n        partes = []\n        for c in columnas_mostrar:\n            valor = str(fila[c])\n            partes.append(f"{c}: {valor if len(valor) &lt;= 80 else valor[:79] + \'…\'}")\n        print("   omitida: " + " | ".join(partes))\n    if len(quitados) &gt; 30:\n        print(f"   ... y {len(quitados) - 30} más")\n    if "Total Earnings" in quitados.columns:\n        print(f"   comisión (Total Earnings) de las omitidas: "\n              f"{sum(a_numero(v) for v in quitados[\'Total Earnings\']):,.2f}")\nprint(f"Productos en el resumen: {len(resultado)} "\n      f"({sin_publicar} sin ninguna publicación asociada).")\nprint(f"Publicaciones asociadas usadas: {n_posts} ({len(posts_asoc)} pares publicación-producto); "\n      f"{n_compartidas} mencionan más de un producto. Ignoradas que no entraron: {n_ignoradas}.")\nprint(f"Productos con 0 publicaciones exactas pero con ignoradas parecidas "\n      f"(posible nombre mutilado; su N está subestimado): {sin_exactas_con_parecidas}")\nif n_repetidos:\n    print(f"AVISO: {n_repetidos} filas de Ventas comparten título con otra; no reciben "\n          f"publicaciones (columna \'Título repetido en Ventas\' = Sí). Quítalas con Select "\n          f"Rows antes de analizar o corrige el título en Ventas.")\n\nout_data = table_from_frame(resultado)\n', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Recibe dos tablas: las ventas limpias y la salida de "INT-01 Asociar\n# publicaciones con productos". El orden en que se conecten da igual, cada una\n# se reconoce por columnas que solo ella tiene. Aquí no se busca ninguna\n# coincidencia: solo se resumen las publicaciones que el paso anterior marcó\n# como "Asociada".\n#\n# El resultado trae una fila por cada registro de Ventas (sin agrupar ni unir\n# filas), con sus datos de la tienda en línea tal cual y el resumen de sus publicaciones en\n# X. Lo único que se deja fuera son los registros "genéricos" (enlaces a la\n# tienda, sin un producto puntual).\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nasociadas = next((t for t in tablas\n                  if {"Estado", "Texto del post"} &lt;= nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\n\nif ventas is None or asociadas is None:\n    raise ValueError(\n        "Conecta las dos tablas: la de Ventas (con \'Product Title\') y la salida "\n        "de \'INT-01 Asociar publicaciones con productos\' (con \'Estado\')."\n    )\n\ndf_ventas = table_to_frame(ventas, include_metas=True)\ndf_posts = table_to_frame(asociadas, include_metas=True)\n\nfor df in (df_ventas, df_posts):\n    for col in df.columns:\n        if str(df[col].dtype) == "category":\n            df[col] = df[col].astype(object)\n\n# Al resumen solo entran las publicaciones asociadas; las ignoradas se quedan\n# fuera (están en la tabla de referencia del paso anterior). De las ignoradas\n# solo se aprovecha cuántas hay por "producto más parecido", como dato extra.\nn_ignoradas = int((df_posts["Estado"] != "Asociada").sum())\nposts_asoc = df_posts[df_posts["Estado"] == "Asociada"].copy()\nCOL_PARECIDO = "Producto más parecido (referencia)"\nif COL_PARECIDO in df_posts.columns:\n    parecidas_por_titulo = (\n        df_posts[(df_posts["Estado"] == "Ignorada") &amp; (df_posts["Motivo"] == "Sin coincidencia")]\n        [COL_PARECIDO].dropna().astype(str).str.strip().value_counts()\n    )\nelse:\n    parecidas_por_titulo = pd.Series(dtype=int)\nposts_asoc["Product Title"] = posts_asoc["Product Title"].astype(str).str.strip()\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\n# Los registros "genéricos" (enlaces a la tienda, sin un producto puntual) no\n# son un producto, así que no entran a un resumen por producto.\nn_filas_ventas = len(df_ventas)\nif "es_generico" in df_ventas.columns:\n    es_quitado = df_ventas["es_generico"].apply(es_verdadero)\n    motivo_quitado = "registro genérico (es_generico)"\nelse:\n    es_quitado = df_ventas["Product Title"].apply(es_valor_centinela)\n    motivo_quitado = "título vacío o sin valor"\nquitados = df_ventas[es_quitado]       # se listan en la consola al final\ndf_ventas = df_ventas[~es_quitado]\n\n# Cada fila de posts_asoc ya es un par (publicación, producto). Si una\n# publicación menciona dos productos sale en dos filas, y sus métricas cuentan\n# completas para cada uno. "Publicaciones compartidas con otro producto" dice\n# cuántas de las publicaciones de un producto están en ese caso.\ncol_id = "ID del post" if "ID del post" in posts_asoc.columns else "Texto del post"\nproductos_por_post = posts_asoc.groupby(col_id)["Product Title"].transform("nunique")\nposts_asoc["_compartida"] = (productos_por_post &gt; 1).astype(int)\n\nCOLUMNAS_X_A_SUMAR = [c for c in [\n    "Impresiones", "Me gusta", "Interacciones", "Guardados", "Compartidos",\n    "Nuevos seguidores", "Respuestas", "Reposts", "Clics en URL",\n] if c in posts_asoc.columns]\nfor col in COLUMNAS_X_A_SUMAR:\n    posts_asoc[col] = posts_asoc[col].apply(a_numero)\n\nagg_dict = {"N publicaciones": ("Product Title", "count")}\nfor col in COLUMNAS_X_A_SUMAR:\n    agg_dict[col] = (col, "sum")\nagg_dict["Publicaciones compartidas con otro producto"] = ("_compartida", "sum")\nresumen_x = posts_asoc.groupby("Product Title").agg(**agg_dict).reset_index()\n\nresumen_x = resumen_x.rename(columns={\n    "Impresiones": "Impresiones (X)", "Me gusta": "Me gusta (X)",\n    "Interacciones": "Interacciones (X)", "Clics en URL": "Clics en URL (X)",\n})\n\n# Columnas de Ventas que pasan al resumen. "Order Quantity" es la Frecuencia\n# (F) del análisis FM con K-Means; "datos_incompletos" sirve para excluir o\n# revisar los productos cuyos ceros no vienen de la fuente oficial.\nCOLUMNAS_VENTAS = [c for c in [\n    "Product Title", "Category", "Clicks", "Items Ordered", "Items Shipped",\n    "Order Quantity", "Items Returned", "Total Earnings", "datos_incompletos",\n] if c in df_ventas.columns]\nresumen_ventas = df_ventas[COLUMNAS_VENTAS].copy().rename(columns={"Clicks": "Clicks (ventas)"})\nresumen_ventas["Product Title"] = resumen_ventas["Product Title"].astype(str).str.strip()\n\n# Un título repetido en Ventas no recibe publicaciones: el paso anterior las\n# dejó ignoradas porque no se sabe a cuál de los registros se refieren.\nforma = resumen_ventas["Product Title"].str.lower().str.replace(r"\\s+", " ", regex=True).str.strip()\nrepetido = forma.duplicated(keep=False)\nn_repetidos = int(repetido.sum())\n\nresultado = resumen_ventas.merge(resumen_x, on="Product Title", how="left")\nfor col in resumen_x.columns:\n    if col != "Product Title":\n        resultado[col] = resultado[col].fillna(0.0)\nresultado["N publicaciones"] = resultado["N publicaciones"].astype(int)\nresultado["Publicaciones compartidas con otro producto"] = (\n    resultado["Publicaciones compartidas con otro producto"].astype(int))\n\nresultado["Título repetido en Ventas"] = pd.Categorical(\n    repetido.map({True: "Sí", False: "No"}).values, categories=["No", "Sí"], ordered=True)\n\n# Publicaciones ignoradas (sin coincidencia exacta) cuyo nombre se parece a\n# este producto, según la columna de referencia del paso anterior. Un producto\n# con 0 publicaciones exactas pero varias parecidas probablemente sí se\n# publicó con el nombre mutilado, y entonces su "N publicaciones" está de menos.\nresultado["Publicaciones ignoradas parecidas"] = (\n    resultado["Product Title"].map(parecidas_por_titulo).fillna(0).astype(int))\n\nresultado = resultado.sort_values("N publicaciones", ascending=False, kind="mergesort").reset_index(drop=True)\n\nsin_publicar = int((resultado["N publicaciones"] == 0).sum())\nsin_exactas_con_parecidas = int(((resultado["N publicaciones"] == 0)\n                                 &amp; (resultado["Publicaciones ignoradas parecidas"] &gt; 0)).sum())\nn_posts = int(posts_asoc[col_id].nunique())\nn_compartidas = int(posts_asoc.loc[posts_asoc["_compartida"] == 1, col_id].nunique())\nprint(f"Ventas recibidas: {n_filas_ventas} filas. Omitidas del resumen: {len(quitados)} "\n      f"({motivo_quitado}). En el resumen: {len(resultado)}.")\nif len(quitados):\n    columnas_mostrar = [c for c in ("ASIN", "Product Title", "Category", "Clicks", "Total Earnings")\n                        if c in quitados.columns]\n    for _, fila in quitados.head(30).iterrows():\n        partes = []\n        for c in columnas_mostrar:\n            valor = str(fila[c])\n            partes.append(f"{c}: {valor if len(valor) &lt;= 80 else valor[:79] + \'…\'}")\n        print("   omitida: " + " | ".join(partes))\n    if len(quitados) &gt; 30:\n        print(f"   ... y {len(quitados) - 30} más")\n    if "Total Earnings" in quitados.columns:\n        print(f"   comisión (Total Earnings) de las omitidas: "\n              f"{sum(a_numero(v) for v in quitados[\'Total Earnings\']):,.2f}")\nprint(f"Productos en el resumen: {len(resultado)} "\n      f"({sin_publicar} sin ninguna publicación asociada).")\nprint(f"Publicaciones asociadas usadas: {n_posts} ({len(posts_asoc)} pares publicación-producto); "\n      f"{n_compartidas} mencionan más de un producto. Ignoradas que no entraron: {n_ignoradas}.")\nprint(f"Productos con 0 publicaciones exactas pero con ignoradas parecidas "\n      f"(posible nombre mutilado; su N está subestimado): {sin_exactas_con_parecidas}")\nif n_repetidos:\n    print(f"AVISO: {n_repetidos} filas de Ventas comparten título con otra; no reciben "\n          f"publicaciones (columna \'Título repetido en Ventas\' = Sí). Quítalas con Select "\n          f"Rows antes de analizar o corrige el título en Ventas.")\n\nout_data = table_from_frame(resultado)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
