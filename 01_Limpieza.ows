		<properties node_id="1" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x01p\x00\x00\x00\x80\x00\x00\x04v\x00\x00\x02_\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Orange suele tratar como "categoría" las columnas de texto que se repiten\n# mucho (Category, Product Title, ASIN). Las paso a texto normal para poder\n# comparar y cambiar valores sin que se queje.\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\n# "Date" es la fecha del reporte, no la de la compra, así que no sirve. La\n# quito desde el primer paso para que no estorbe más adelante.\ndf = df.drop(columns=["Date"], errors="ignore")\n\n# Valores que usa la tienda en línea cuando no hay producto o no hay dato. Se comparan en\n# minúsculas y sin espacios, así da igual si un mes viene "None" y otro "N/A".\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    if valor is None:\n        return True\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\n# Una fila es "genérica" cuando su ASIN no apunta a un producto real (por\n# ejemplo, un enlace a la tienda completa). No se borra, solo se marca con\n# Sí/No en una columna categórica.\ndf["es_generico"] = pd.Categorical(\n    df["ASIN"].apply(es_valor_centinela).map({True: "Sí", False: "No"}),\n    categories=["No", "Sí"])\n\nout_data = table_from_frame(df)\n', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Orange suele tratar como "categoría" las columnas de texto que se repiten\n# mucho (Category, Product Title, ASIN) por lo que hay que convertirlas.\n\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\n# Se elimina la columna DATE por ser la fecha del reporte y no la de la venta\ndf = df.drop(columns=["Date"], errors="ignore")\n\n# Valores que usa la tienda en línea cuando no hay producto o no hay dato. Se comparan en\n# minúsculas y sin espacios, así da igual si un mes viene "None" y otro "N/A".\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    if valor is None:\n        return True\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\n# Una fila es "genérica" cuando su ASIN no apunta a un producto real (por\n# ejemplo, un enlace a la tienda completa). No se borra, solo se marca con\n# Sí/No en una columna categórica.\ndf["es_generico"] = pd.Categorical(\n    df["ASIN"].apply(es_valor_centinela).map({True: "Sí", False: "No"}),\n    categories=["No", "Sí"])\n\nout_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="2" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,\x00\x00\x00\x01\x02\x00\x00\x00\x06\x00\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,', 'scriptLibrary': [{'name': 'Script', 'script': 'import time\nimport requests\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Lo mismo que en el paso anterior. Si una columna se queda como categoría no\n# se le puede poner un título que no estuviera ya entre sus valores.\n\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    if valor is None:\n        return True\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\n# Se configura la llamada a la API. Cuando son datos sintéticos, este\n# script no hace nada\n\nAPI_URL = "http://SERVIDOR_NO_CONFIGURADO:5000/api/tienda/products"\nTAMANO_LOTE = 10       # ASINs que se mandan en cada petición\nESPERA_SEGUNDOS = 10   # pausa entre lotes para no saturar la API\n\n# Solo se consultan los ASIN reales a los que les falta el Product Title.\n# La categoría nunca se cambia, aunque la API la devuelva, para no pisar las\n# que ya estaban bien capturadas (por ejemplo las que están en español).\nnecesita_busqueda = (~df["ASIN"].apply(es_valor_centinela)) &amp; (\n    df["Product Title"].apply(es_valor_centinela)\n)\nasins_pendientes = df.loc[necesita_busqueda, "ASIN"].unique().tolist()\nno_encontrados = []\n\nif not asins_pendientes:\n    print("No hay ASINs pendientes de resolver por API.")\nelse:\n    for i in range(0, len(asins_pendientes), TAMANO_LOTE):\n        lote = asins_pendientes[i:i + TAMANO_LOTE]\n        try:\n            resp = requests.post(API_URL, json={"ids": lote}, timeout=30)\n            resp.raise_for_status()\n            data = resp.json()\n        except Exception as e:\n            # Si falla la conexión no puedo concluir que el producto no\n            # existe. Lo dejo pendiente para la siguiente corrida.\n            print(f"Error de conexión consultando el lote {lote}: {e}. "\n                  f"Se deja pendiente, no se elimina.")\n            continue\n\n        if not data.get("success", False):\n            # La API sí contestó, pero con un error propio (no de red).\n            # Igual que arriba, el producto queda pendiente.\n            print(f"La API respondió error para el lote {lote}: "\n                  f"{data.get(\'error\')}. Se deja pendiente, no se elimina.")\n            continue\n\n        encontrados = {item["asin"]: item for item in data.get("parsed", [])}\n        for asin in lote:\n            item = encontrados.get(asin)\n            if item is None:\n                no_encontrados.append(asin)\n                continue\n\n            titulo = item.get("title")\n            if not es_valor_centinela(titulo):\n                mask = df["ASIN"] == asin\n                df.loc[mask, "Product Title"] = titulo\n            # Aquí no se toca Category: se queda como venía en el archivo.\n\n        if i + TAMANO_LOTE &lt; len(asins_pendientes):\n            time.sleep(ESPERA_SEGUNDOS)\n\n    if no_encontrados:\n        print(f"ASINs eliminados por no existir en la tienda en línea: {no_encontrados}")\n    # Si el producto no está ni en mis datos ni en la tienda online, se descarta.\n    df = df[~df["ASIN"].isin(no_encontrados)].reset_index(drop=True)\n\nout_data = table_from_frame(df)\n', 'filename': None}], 'scriptText': 'import time\nimport requests\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Lo mismo que en el paso anterior. Si una columna se queda como categoría no\n# se le puede poner un título que no estuviera ya entre sus valores.\n\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    if valor is None:\n        return True\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\n# Se configura la llamada a la API. Cuando son datos sintéticos, este\n# script no hace nada\n\nAPI_URL = "http://SERVIDOR_NO_CONFIGURADO:5000/api/tienda/products"\nTAMANO_LOTE = 10       # ASINs que se mandan en cada petición\nESPERA_SEGUNDOS = 10   # pausa entre lotes para no saturar la API\n\n# Solo se consultan los ASIN reales a los que les falta el Product Title.\n# La categoría nunca se cambia, aunque la API la devuelva, para no pisar las\n# que ya estaban bien capturadas (por ejemplo las que están en español).\nnecesita_busqueda = (~df["ASIN"].apply(es_valor_centinela)) &amp; (\n    df["Product Title"].apply(es_valor_centinela)\n)\nasins_pendientes = df.loc[necesita_busqueda, "ASIN"].unique().tolist()\nno_encontrados = []\n\nif not asins_pendientes:\n    print("No hay ASINs pendientes de resolver por API.")\nelse:\n    for i in range(0, len(asins_pendientes), TAMANO_LOTE):\n        lote = asins_pendientes[i:i + TAMANO_LOTE]\n        try:\n            resp = requests.post(API_URL, json={"ids": lote}, timeout=30)\n            resp.raise_for_status()\n            data = resp.json()\n        except Exception as e:\n            # Si falla la conexión no puedo concluir que el producto no\n            # existe. Lo dejo pendiente para la siguiente corrida.\n            print(f"Error de conexión consultando el lote {lote}: {e}. "\n                  f"Se deja pendiente, no se elimina.")\n            continue\n\n        if not data.get("success", False):\n            # La API sí contestó, pero con un error propio (no de red).\n            # Igual que arriba, el producto queda pendiente.\n            print(f"La API respondió error para el lote {lote}: "\n                  f"{data.get(\'error\')}. Se deja pendiente, no se elimina.")\n            continue\n\n        encontrados = {item["asin"]: item for item in data.get("parsed", [])}\n        for asin in lote:\n            item = encontrados.get(asin)\n            if item is None:\n                no_encontrados.append(asin)\n                continue\n\n            titulo = item.get("title")\n            if not es_valor_centinela(titulo):\n                mask = df["ASIN"] == asin\n                df.loc[mask, "Product Title"] = titulo\n            # Aquí no se toca Category: se queda como venía en el archivo.\n\n        if i + TAMANO_LOTE &lt; len(asins_pendientes):\n            time.sleep(ESPERA_SEGUNDOS)\n\n    if no_encontrados:\n        print(f"ASINs eliminados por no existir en la tienda en línea: {no_encontrados}")\n    # Si el producto no está ni en mis datos ni en la tienda online, se descarta.\n    df = df[~df["ASIN"].isin(no_encontrados)].reset_index(drop=True)\n\nout_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="3" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x01p\x00\x00\x00\x80\x00\x00\x04v\x00\x00\x02_\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import numpy as np\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Mismo ajuste de los pasos anteriores: las columnas con muchos "-" pueden\n# llegar como categoría, así que las paso a texto antes de operar con ellas.\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nCOLUMNAS_NUMERICAS = [\n    "Indirect Items Ordered", "Direct Items Ordered", "Items Ordered",\n    "Direct Conversion Rate", "Order Quantity", "Product Conversion Rate",\n    "Order Conversion Rate", "Commission Rate", "Ordered Revenue",\n    "Items Shipped", "Items Returned", "Items Shipped Revenue",\n    "Items Shipped Earnings", "Items Returned Revenue", "Items Returned Earnings",\n]\nCOL_TOTAL = "Total Earnings"\n\n\ndef es_dash(valor):\n    return str(valor).strip() == "-"\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\n# Si Total Earnings es "-", el resto de la fila vale 0 con seguridad: sin\n# ganancias no hay órdenes, ni envíos, ni devoluciones.\ntotal_es_dash = df[COL_TOTAL].apply(es_dash).to_numpy()\n\n# En las demás columnas un "-" se cambia por 0 para poder calcular. Pero si\n# Total Earnings sí trae un dato real, ese 0 es solo una aproximación, y por\n# eso marco la fila como dato incompleto.\nincompleto_mask = np.zeros(len(df), dtype=bool)\nfor col in COLUMNAS_NUMERICAS:\n    dash_aqui = df[col].apply(es_dash).to_numpy()\n    incompleto_mask |= dash_aqui &amp; (~total_es_dash)\n    df[col] = df[col].apply(a_numero)\n\n# Bandera Sí/No, guardada como categoría (no como 0/1).\ndf["datos_incompletos"] = pd.Categorical(\n    np.where(incompleto_mask, "Sí", "No"), categories=["No", "Sí"])\ndf[COL_TOTAL] = df[COL_TOTAL].apply(a_numero)\n\nout_data = table_from_frame(df)\n', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\n# Mismo ajuste de los pasos anteriores: las columnas con muchos "-" pueden\n# llegar como categoría, así que las paso a texto antes de operar con ellas.\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nCOLUMNAS_NUMERICAS = [\n    "Indirect Items Ordered", "Direct Items Ordered", "Items Ordered",\n    "Direct Conversion Rate", "Order Quantity", "Product Conversion Rate",\n    "Order Conversion Rate", "Commission Rate", "Ordered Revenue",\n    "Items Shipped", "Items Returned", "Items Shipped Revenue",\n    "Items Shipped Earnings", "Items Returned Revenue", "Items Returned Earnings",\n]\nCOL_TOTAL = "Total Earnings"\n\n\ndef es_dash(valor):\n    return str(valor).strip() == "-"\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\n# Si Total Earnings es "-", el resto de la fila vale 0 con seguridad: sin\n# ganancias no hay órdenes, ni envíos, ni devoluciones.\ntotal_es_dash = df[COL_TOTAL].apply(es_dash).to_numpy()\n\n# En las demás columnas un "-" se cambia por 0 para poder calcular. Pero si\n# Total Earnings sí trae un dato real, ese 0 es solo una aproximación, y por\n# eso marco la fila como dato incompleto.\nincompleto_mask = np.zeros(len(df), dtype=bool)\nfor col in COLUMNAS_NUMERICAS:\n    dash_aqui = df[col].apply(es_dash).to_numpy()\n    incompleto_mask |= dash_aqui &amp; (~total_es_dash)\n    df[col] = df[col].apply(a_numero)\n\n# Bandera Sí/No, guardada como categoría (no como 0/1).\ndf["datos_incompletos"] = pd.Categorical(\n    np.where(incompleto_mask, "Sí", "No"), categories=["No", "Sí"])\ndf[COL_TOTAL] = df[COL_TOTAL].apply(a_numero)\n\nout_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="4" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': True, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,\x00\x00\x00\x01\x02\x00\x00\x00\x06\x00\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,', 'scriptLibrary': [{'name': 'Script', 'script': 'import re\nimport sys\nfrom pathlib import Path\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\n# Carpeta donde están TODOS los archivos descargados de X (los 5 juntos).\n# Se puede escribir de dos maneras:\n#   - ruta completa:  r"C:\\Datos\\X\\Julio"\n#   - ruta relativa:  r"datos/x/sinteticos"  (se busca desde la carpeta donde está\n#     guardado este flujo .ows, así el flujo se puede mover o compartir\n#     junto con su carpeta de datos sin cambiar nada)\nRUTA_CARPETA = r"datos/x/sinteticos"\n# Si la carpeta trae otros archivos, solo se leen los que tengan este texto en\n# el nombre (por ejemplo "X_"). Vacío = se leen todos.\nFILTRO_NOMBRE = ""\nEXTENSIONES = {".csv", ".xlsx"}\n# =======================================================================\n\n# El widget guarda las variables entre corridas. Si esta corrida falla a la\n# mitad, sin esta línea se volvería a mandar el resultado de la corrida\n# anterior como si fuera el de ahora.\nout_data = None\n\nCOLUMNAS_TEXTO = ["ID del post", "Fecha", "Texto del post", "Postear enlace"]\nCOLUMNAS_NUMERICAS = [\n    "Impresiones", "Me gusta", "Interacciones", "Guardados", "Compartidos",\n    "Nuevos seguidores", "Respuestas", "Reposts", "Visitas del perfil",\n    "Ampliaciones de detalles", "Clics en URL", "Clics en hashtags",\n    "Clics en enlaces permanentes",\n]\nCOLUMNAS_OBLIGATORIAS = {"ID del post", "Texto del post", "Postear enlace"}\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la guarda como\n    \'basedir\' en el entorno del flujo, pero el script no la recibe; para\n    llegar a ella subo por las llamadas hasta encontrar el widget que está\n    ejecutando este código. Devuelve None si el flujo aún no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\ndef leer_archivo(ruta):\n    # Las columnas de texto se leen como texto. Si no, el ID de 19 dígitos se\n    # volvería número y perdería precisión antes de poder repararlo.\n    tipos = {c: str for c in COLUMNAS_TEXTO}\n    if ruta.suffix.lower() == ".csv":\n        for codificacion in ("utf-8-sig", "cp1252"):\n            try:\n                df = pd.read_csv(ruta, dtype=tipos, encoding=codificacion)\n                break\n            except UnicodeDecodeError:\n                continue\n        else:\n            raise ValueError(f"No se pudo leer {ruta.name}: codificación desconocida.")\n    else:\n        df = pd.read_excel(ruta, dtype=tipos)\n    df.columns = [str(c).strip() for c in df.columns]\n    return df\n\n\ncarpeta = Path(RUTA_CARPETA)\nif not carpeta.is_absolute():\n    carpeta = (carpeta_del_flujo() or Path.cwd()) / carpeta\nif not carpeta.is_dir():\n    raise FileNotFoundError(f"No se encontró la carpeta: {carpeta}")\n\narchivos = sorted(\n    p for p in carpeta.iterdir()\n    if p.is_file()\n    and p.suffix.lower() in EXTENSIONES\n    and not p.name.startswith("~$")  # archivos temporales de Excel\n    and FILTRO_NOMBRE.lower() in p.name.lower()\n)\nif not archivos:\n    raise FileNotFoundError(f"No hay archivos {sorted(EXTENSIONES)} en: {carpeta}")\n\npartes = []\nfor ruta in archivos:\n    parte = leer_archivo(ruta)\n    faltantes = COLUMNAS_OBLIGATORIAS - set(parte.columns)\n    if faltantes:\n        # Por si se cuela otro archivo en la carpeta (por ejemplo el de ventas)\n        print(f"OMITIDO {ruta.name}: no parece una exportación de publicaciones "\n              f"de X (faltan las columnas {sorted(faltantes)}).")\n        continue\n    for col in COLUMNAS_NUMERICAS:\n        if col in parte.columns:\n            original = parte[col]\n            convertida = pd.to_numeric(original, errors="coerce")\n            perdidos = int(convertida.isna().sum() - original.isna().sum())\n            if perdidos:\n                print(f"AVISO {ruta.name}: {perdidos} valores no numéricos en "\n                      f"\'{col}\' quedaron vacíos.")\n            parte[col] = convertida\n    print(f"Leído {ruta.name}: {len(parte)} filas.")\n    partes.append(parte)\n\nif not partes:\n    raise ValueError("Ningún archivo de la carpeta tiene el formato de publicaciones de X.")\n\ndf = pd.concat(partes, ignore_index=True)\nprint(f"Total unido: {len(df)} filas de {len(partes)} archivos.")\n\n\ndef reparar_mojibake(texto):\n    """Arregla los acentos rotos por doble codificación (texto UTF-8 que en\n    algún momento se leyó como Windows-1252). Si el texto ya está bien, no\n    lo toca."""\n    if texto is None or pd.isna(texto):\n        return texto\n    texto = str(texto)\n    for codec in ("cp1252", "latin-1"):\n        try:\n            reparado = texto.encode(codec).decode("utf-8")\n            if reparado != texto:\n                return reparado\n        except (UnicodeDecodeError, UnicodeEncodeError):\n            continue\n    return texto\n\n\n# Se aplica a todas las columnas de texto por si el problema aparece en otra\n# columna en un export futuro.\nfor col in df.select_dtypes(include=["object", "string"]).columns:\n    df[col] = df[col].apply(reparar_mojibake)\n\n\nMESES = {"Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06",\n         "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"}\n\n\ndef parsear_fecha_x(valor):\n    """Convierte \'Tue, Jul 7, 2026\' en \'2026-07-07\'. Los meses se traducen a\n    mano en vez de usar strptime, porque strptime depende del idioma del\n    equipo donde corra Orange."""\n    texto = str(valor).strip()\n    m = re.match(r"^\\w{3},\\s*(\\w{3})\\s+(\\d{1,2}),\\s*(\\d{4})$", texto)\n    if not m:\n        return texto\n    mes_abbr, dia, anio = m.groups()\n    mes = MESES.get(mes_abbr)\n    return f"{anio}-{mes}-{int(dia):02d}" if mes else texto\n\n\nif "Fecha" in df.columns:\n    df["Fecha"] = df["Fecha"].apply(parsear_fecha_x)\n\n\ndef extraer_id_real(url):\n    """La columna \'ID del post\' llega redondeada (termina en ceros) porque se\n    guardó como un número de precisión limitada. El ID completo sigue intacto\n    en el enlace de \'Postear enlace\', así que lo saco de ahí."""\n    if url is None or pd.isna(url):\n        return None\n    m = re.search(r"/status/(\\d+)", str(url))\n    return m.group(1) if m else None\n\n\nids_reales = df["Postear enlace"].apply(extraer_id_real)\nsin_id = int(ids_reales.isna().sum())\nif sin_id:\n    print(f"AVISO: {sin_id} filas sin ID reconstruible desde el enlace; "\n          f"se conservó su ID original (posiblemente redondeado).")\ndf["ID del post"] = [\n    nuevo if nuevo else str(original).strip()\n    for nuevo, original in zip(ids_reales, df["ID del post"])\n]\n\nout_data = table_from_frame(df)\n', 'filename': None}], 'scriptText': 'import re\nimport sys\nfrom pathlib import Path\nimport pandas as pd\nfrom Orange.data.pandas_compat import table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\n# Carpeta donde están TODOS los archivos descargados de X (los 5 juntos).\n# Se puede escribir de dos maneras:\n#   - ruta completa:  r"C:\\Datos\\X\\Julio"\n#   - ruta relativa:  r"datos/x/sinteticos"  (se busca desde la carpeta donde está\n#     guardado este flujo .ows, así el flujo se puede mover o compartir\n#     junto con su carpeta de datos sin cambiar nada)\nRUTA_CARPETA = r"datos/x/sinteticos"\n# Si la carpeta trae otros archivos, solo se leen los que tengan este texto en\n# el nombre (por ejemplo "X_"). Vacío = se leen todos.\nFILTRO_NOMBRE = ""\nEXTENSIONES = {".csv", ".xlsx"}\n# =======================================================================\n\n# El widget guarda las variables entre corridas. Si esta corrida falla a la\n# mitad, sin esta línea se volvería a mandar el resultado de la corrida\n# anterior como si fuera el de ahora.\nout_data = None\n\nCOLUMNAS_TEXTO = ["ID del post", "Fecha", "Texto del post", "Postear enlace"]\nCOLUMNAS_NUMERICAS = [\n    "Impresiones", "Me gusta", "Interacciones", "Guardados", "Compartidos",\n    "Nuevos seguidores", "Respuestas", "Reposts", "Visitas del perfil",\n    "Ampliaciones de detalles", "Clics en URL", "Clics en hashtags",\n    "Clics en enlaces permanentes",\n]\nCOLUMNAS_OBLIGATORIAS = {"ID del post", "Texto del post", "Postear enlace"}\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la guarda como\n    \'basedir\' en el entorno del flujo, pero el script no la recibe; para\n    llegar a ella subo por las llamadas hasta encontrar el widget que está\n    ejecutando este código. Devuelve None si el flujo aún no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\ndef leer_archivo(ruta):\n    # Las columnas de texto se leen como texto. Si no, el ID de 19 dígitos se\n    # volvería número y perdería precisión antes de poder repararlo.\n    tipos = {c: str for c in COLUMNAS_TEXTO}\n    if ruta.suffix.lower() == ".csv":\n        for codificacion in ("utf-8-sig", "cp1252"):\n            try:\n                df = pd.read_csv(ruta, dtype=tipos, encoding=codificacion)\n                break\n            except UnicodeDecodeError:\n                continue\n        else:\n            raise ValueError(f"No se pudo leer {ruta.name}: codificación desconocida.")\n    else:\n        df = pd.read_excel(ruta, dtype=tipos)\n    df.columns = [str(c).strip() for c in df.columns]\n    return df\n\n\ncarpeta = Path(RUTA_CARPETA)\nif not carpeta.is_absolute():\n    carpeta = (carpeta_del_flujo() or Path.cwd()) / carpeta\nif not carpeta.is_dir():\n    raise FileNotFoundError(f"No se encontró la carpeta: {carpeta}")\n\narchivos = sorted(\n    p for p in carpeta.iterdir()\n    if p.is_file()\n    and p.suffix.lower() in EXTENSIONES\n    and not p.name.startswith("~$")  # archivos temporales de Excel\n    and FILTRO_NOMBRE.lower() in p.name.lower()\n)\nif not archivos:\n    raise FileNotFoundError(f"No hay archivos {sorted(EXTENSIONES)} en: {carpeta}")\n\npartes = []\nfor ruta in archivos:\n    parte = leer_archivo(ruta)\n    faltantes = COLUMNAS_OBLIGATORIAS - set(parte.columns)\n    if faltantes:\n        # Por si se cuela otro archivo en la carpeta (por ejemplo el de ventas)\n        print(f"OMITIDO {ruta.name}: no parece una exportación de publicaciones "\n              f"de X (faltan las columnas {sorted(faltantes)}).")\n        continue\n    for col in COLUMNAS_NUMERICAS:\n        if col in parte.columns:\n            original = parte[col]\n            convertida = pd.to_numeric(original, errors="coerce")\n            perdidos = int(convertida.isna().sum() - original.isna().sum())\n            if perdidos:\n                print(f"AVISO {ruta.name}: {perdidos} valores no numéricos en "\n                      f"\'{col}\' quedaron vacíos.")\n            parte[col] = convertida\n    print(f"Leído {ruta.name}: {len(parte)} filas.")\n    partes.append(parte)\n\nif not partes:\n    raise ValueError("Ningún archivo de la carpeta tiene el formato de publicaciones de X.")\n\ndf = pd.concat(partes, ignore_index=True)\nprint(f"Total unido: {len(df)} filas de {len(partes)} archivos.")\n\n\ndef reparar_mojibake(texto):\n    """Arregla los acentos rotos por doble codificación (texto UTF-8 que en\n    algún momento se leyó como Windows-1252). Si el texto ya está bien, no\n    lo toca."""\n    if texto is None or pd.isna(texto):\n        return texto\n    texto = str(texto)\n    for codec in ("cp1252", "latin-1"):\n        try:\n            reparado = texto.encode(codec).decode("utf-8")\n            if reparado != texto:\n                return reparado\n        except (UnicodeDecodeError, UnicodeEncodeError):\n            continue\n    return texto\n\n\n# Se aplica a todas las columnas de texto por si el problema aparece en otra\n# columna en un export futuro.\nfor col in df.select_dtypes(include=["object", "string"]).columns:\n    df[col] = df[col].apply(reparar_mojibake)\n\n\nMESES = {"Jan": "01", "Feb": "02", "Mar": "03", "Apr": "04", "May": "05", "Jun": "06",\n         "Jul": "07", "Aug": "08", "Sep": "09", "Oct": "10", "Nov": "11", "Dec": "12"}\n\n\ndef parsear_fecha_x(valor):\n    """Convierte \'Tue, Jul 7, 2026\' en \'2026-07-07\'. Los meses se traducen a\n    mano en vez de usar strptime, porque strptime depende del idioma del\n    equipo donde corra Orange."""\n    texto = str(valor).strip()\n    m = re.match(r"^\\w{3},\\s*(\\w{3})\\s+(\\d{1,2}),\\s*(\\d{4})$", texto)\n    if not m:\n        return texto\n    mes_abbr, dia, anio = m.groups()\n    mes = MESES.get(mes_abbr)\n    return f"{anio}-{mes}-{int(dia):02d}" if mes else texto\n\n\nif "Fecha" in df.columns:\n    df["Fecha"] = df["Fecha"].apply(parsear_fecha_x)\n\n\ndef extraer_id_real(url):\n    """La columna \'ID del post\' llega redondeada (termina en ceros) porque se\n    guardó como un número de precisión limitada. El ID completo sigue intacto\n    en el enlace de \'Postear enlace\', así que lo saco de ahí."""\n    if url is None or pd.isna(url):\n        return None\n    m = re.search(r"/status/(\\d+)", str(url))\n    return m.group(1) if m else None\n\n\nids_reales = df["Postear enlace"].apply(extraer_id_real)\nsin_id = int(ids_reales.isna().sum())\nif sin_id:\n    print(f"AVISO: {sin_id} filas sin ID reconstruible desde el enlace; "\n          f"se conservó su ID original (posiblemente redondeado).")\ndf["ID del post"] = [\n    nuevo if nuevo else str(original).strip()\n    for nuevo, original in zip(ids_reales, df["ID del post"])\n]\n\nout_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="6" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00b\x00\x00\x04w\x00\x00\x02`\x00\x00\x01p\x00\x00\x00\x80\x00\x00\x04v\x00\x00\x02_\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00\x80\x00\x00\x04v\x00\x00\x02_', 'scriptLibrary': [{'name': 'Script', 'script': 'from Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\n# Un mismo post puede venir en dos archivos cuando los rangos de fechas se\n# traslapan, y sus métricas no son iguales en cada uno porque el post sigue\n# juntando vistas con el tiempo. De cada ID repetido me quedo con el registro\n# que tenga más Impresiones (el más actualizado), no con el primero que salga.\ndf["_impresiones_num"] = df["Impresiones"].apply(a_numero)\n\nantes = len(df)\ndf = (\n    df.sort_values("_impresiones_num", ascending=False)\n      .drop_duplicates(subset=["ID del post"], keep="first")\n      .drop(columns=["_impresiones_num"])\n      .reset_index(drop=True)\n)\ndespues = len(df)\nif antes != despues:\n    print(f"Se eliminaron {antes - despues} publicaciones duplicadas (mismo ID del post); "\n          f"se conservó, para cada ID repetido, el registro con más Impresiones.")\n\nout_data = table_from_frame(df)\n', 'filename': None}], 'scriptText': 'from Orange.data.pandas_compat import table_to_frame, table_from_frame\n\ndf = table_to_frame(in_data, include_metas=True)\n\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\n\ndef a_numero(valor):\n    try:\n        return float(str(valor).replace(",", ""))\n    except (ValueError, TypeError):\n        return 0.0\n\n\n# Un mismo post puede venir en dos archivos cuando los rangos de fechas se\n# traslapan, y sus métricas no son iguales en cada uno porque el post sigue\n# juntando vistas con el tiempo. De cada ID repetido me quedo con el registro\n# que tenga más Impresiones (el más actualizado), no con el primero que salga.\ndf["_impresiones_num"] = df["Impresiones"].apply(a_numero)\n\nantes = len(df)\ndf = (\n    df.sort_values("_impresiones_num", ascending=False)\n      .drop_duplicates(subset=["ID del post"], keep="first")\n      .drop(columns=["_impresiones_num"])\n      .reset_index(drop=True)\n)\ndespues = len(df)\nif antes != despues:\n    print(f"Se eliminaron {antes - despues} publicaciones duplicadas (mismo ID del post); "\n          f"se conservó, para cada ID repetido, el registro con más Impresiones.")\n\nout_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
