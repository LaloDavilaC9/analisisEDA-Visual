		<properties node_id="21" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import sys\nfrom pathlib import Path\n\n# ============================ CONFIGURACIÓN ============================\n# Este widget guarda la tabla que le llega para que el siguiente módulo la\n# pueda leer con un widget File. El archivo se escribe en la carpeta\n# "intermedios", que se crea sola junto a este flujo (.ows).\nNOMBRE = "productos_limpios"\nCARPETA = "intermedios"\n# =======================================================================\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la conoce como\n    \'basedir\', pero el script no la recibe; para llegar a ella subo por las\n    llamadas hasta encontrar el widget que ejecuta este código. Devuelve None\n    si el flujo todavía no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\nif in_data is None or len(in_data) == 0:\n    # Si no avisara, el siguiente módulo leería el archivo viejo sin enterarse.\n    raise ValueError("Este widget no recibió datos y no guardó nada; el archivo anterior "\n                     "(si existe) sigue igual. Revisa el widget que está conectado antes.")\n\ndestino = (carpeta_del_flujo() or Path.cwd()) / CARPETA / f"{NOMBRE}.pkl"\ndestino.parent.mkdir(parents=True, exist_ok=True)\n\n# Se guarda en el formato propio de Orange (.pkl) porque conserva tal cual los\n# tipos de columna, el orden de las categorías y las metas. Con Excel o CSV,\n# Orange tendría que volver a adivinarlos al leer.\nin_data.save(str(destino))\n\ncolumnas = len(in_data.domain.variables) + len(in_data.domain.metas)\nprint(f"Guardado en: {destino}")\nprint(f"   {len(in_data)} filas y {columnas} columnas.")\n', 'filename': None}], 'scriptText': 'import sys\nfrom pathlib import Path\n\n# ============================ CONFIGURACIÓN ============================\n# Este widget guarda la tabla que le llega para que el siguiente módulo la\n# pueda leer con un widget File. El archivo se escribe en la carpeta\n# "intermedios", que se crea sola junto a este flujo (.ows).\nNOMBRE = "productos_limpios"\nCARPETA = "intermedios"\n# =======================================================================\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la conoce como\n    \'basedir\', pero el script no la recibe; para llegar a ella subo por las\n    llamadas hasta encontrar el widget que ejecuta este código. Devuelve None\n    si el flujo todavía no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\nif in_data is None or len(in_data) == 0:\n    # Si no avisara, el siguiente módulo leería el archivo viejo sin enterarse.\n    raise ValueError("Este widget no recibió datos y no guardó nada; el archivo anterior "\n                     "(si existe) sigue igual. Revisa el widget que está conectado antes.")\n\ndestino = (carpeta_del_flujo() or Path.cwd()) / CARPETA / f"{NOMBRE}.pkl"\ndestino.parent.mkdir(parents=True, exist_ok=True)\n\n# Se guarda en el formato propio de Orange (.pkl) porque conserva tal cual los\n# tipos de columna, el orden de las categorías y las metas. Con Excel o CSV,\n# Orange tendría que volver a adivinarlos al leer.\nin_data.save(str(destino))\n\ncolumnas = len(in_data.domain.variables) + len(in_data.domain.metas)\nprint(f"Guardado en: {destino}")\nprint(f"   {len(in_data)} filas y {columnas} columnas.")\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="22" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import sys\nfrom pathlib import Path\n\n# ============================ CONFIGURACIÓN ============================\n# Este widget guarda la tabla que le llega para que el siguiente módulo la\n# pueda leer con un widget File. El archivo se escribe en la carpeta\n# "intermedios", que se crea sola junto a este flujo (.ows).\nNOMBRE = "publicaciones_asociadas"\nCARPETA = "intermedios"\n# =======================================================================\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la conoce como\n    \'basedir\', pero el script no la recibe; para llegar a ella subo por las\n    llamadas hasta encontrar el widget que ejecuta este código. Devuelve None\n    si el flujo todavía no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\nif in_data is None or len(in_data) == 0:\n    # Si no avisara, el siguiente módulo leería el archivo viejo sin enterarse.\n    raise ValueError("Este widget no recibió datos y no guardó nada; el archivo anterior "\n                     "(si existe) sigue igual. Revisa el widget que está conectado antes.")\n\ndestino = (carpeta_del_flujo() or Path.cwd()) / CARPETA / f"{NOMBRE}.pkl"\ndestino.parent.mkdir(parents=True, exist_ok=True)\n\n# Se guarda en el formato propio de Orange (.pkl) porque conserva tal cual los\n# tipos de columna, el orden de las categorías y las metas. Con Excel o CSV,\n# Orange tendría que volver a adivinarlos al leer.\nin_data.save(str(destino))\n\ncolumnas = len(in_data.domain.variables) + len(in_data.domain.metas)\nprint(f"Guardado en: {destino}")\nprint(f"   {len(in_data)} filas y {columnas} columnas.")\n', 'filename': None}], 'scriptText': 'import sys\nfrom pathlib import Path\n\n# ============================ CONFIGURACIÓN ============================\n# Este widget guarda la tabla que le llega para que el siguiente módulo la\n# pueda leer con un widget File. El archivo se escribe en la carpeta\n# "intermedios", que se crea sola junto a este flujo (.ows).\nNOMBRE = "publicaciones_asociadas"\nCARPETA = "intermedios"\n# =======================================================================\n\n\ndef carpeta_del_flujo():\n    """Carpeta donde está guardado el .ows abierto. Orange la conoce como\n    \'basedir\', pero el script no la recibe; para llegar a ella subo por las\n    llamadas hasta encontrar el widget que ejecuta este código. Devuelve None\n    si el flujo todavía no se ha guardado."""\n    marco = sys._getframe()\n    while marco is not None:\n        widget = marco.f_locals.get("self")\n        if hasattr(widget, "workflowEnv"):\n            base = (widget.workflowEnv() or {}).get("basedir")\n            if base:\n                return Path(base)\n        marco = marco.f_back\n    return None\n\n\nif in_data is None or len(in_data) == 0:\n    # Si no avisara, el siguiente módulo leería el archivo viejo sin enterarse.\n    raise ValueError("Este widget no recibió datos y no guardó nada; el archivo anterior "\n                     "(si existe) sigue igual. Revisa el widget que está conectado antes.")\n\ndestino = (carpeta_del_flujo() or Path.cwd()) / CARPETA / f"{NOMBRE}.pkl"\ndestino.parent.mkdir(parents=True, exist_ok=True)\n\n# Se guarda en el formato propio de Orange (.pkl) porque conserva tal cual lo