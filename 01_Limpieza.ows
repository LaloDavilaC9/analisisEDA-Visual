		<properties node_id="15" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': False, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': True, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="16" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xf8\x7f\xff\xff\xfd\xf6\xff\xff\xfe\x80\x00\x00\x01-\xff\xff\xf8\x88\xff\xff\xfe\x1c\xff\xff\xfew\x00\x00\x01$\x00\x00\x00\x01\x02\x00\x00\x00\x06\x00\xff\xff\xf8\x80\xff\xff\xfe\x14\xff\xff\xfe\x7f\x00\x00\x01,', 'scriptLibrary': [{'name': 'Script', 'script': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\nZONA_HORARIA = "America/Mexico_City"\n# Franjas horarias en hora local (0 a 23). Cada una es (hora_inicio, hora_fin, nombre).\n\nFRANJAS = [\n    (0, 5, "Madrugada (0-5 h)"),\n    (6, 11, "Mañana (6-11 h)"),\n    (12, 17, "Tarde (12-17 h)"),\n    (18, 23, "Noche (18-23 h)"),\n]\n# =======================================================================\n\n# Evita reenviar la tabla de una corrida anterior si esta falla a la mitad.\nout_data = None\n\nif in_data is None or len(in_data) == 0:\n    raise ValueError("Conecta la salida de \'PUB-03 Quitar respuestas (@)\' a este widget.")\n\ndf = table_to_frame(in_data, include_metas=True)\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nif "ID del post" not in df.columns:\n    raise ValueError("No encuentro la columna \'ID del post\'.")\n\n# Los IDs de X son tipo "Snowflake": los bits altos (id &gt;&gt; 22) son los\n# milisegundos que pasaron desde el 4 de noviembre de 2010 (la época de\n# Twitter). Con eso se recupera el momento exacto de la publicación, en UTC.\nEPOCA_TWITTER_MS = 1288834974657\n\n\ndef milisegundos(valor):\n    try:\n        return (int(str(valor).strip()) &gt;&gt; 22) + EPOCA_TWITTER_MS\n    except (ValueError, TypeError):\n        return None\n\n\nms = df["ID del post"].apply(milisegundos)\nutc = pd.to_datetime(ms.astype("float64"), unit="ms", utc=True)\n\ntry:\n    local = utc.dt.tz_convert(ZONA_HORARIA).dt.tz_localize(None)\nexcept Exception:\n    # Si el equipo no tiene la base de zonas horarias, uso UTC-6 fijo (México\n    # no tiene horario de verano desde 2022).\n    print(f"AVISO: no se pudo cargar la zona \'{ZONA_HORARIA}\'; se usó UTC-6 fijo.")\n    local = (utc - pd.Timedelta(hours=6)).dt.tz_localize(None)\n\nsin_hora = int(local.isna().sum())\nif sin_hora:\n    print(f"AVISO: {sin_hora} publicaciones con ID no decodificable; "\n          f"su hora quedó vacía.")\n\nDIAS = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]\n\n\ndef franja_de(hora):\n    if pd.isna(hora):\n        return None\n    for inicio, fin, nombre in FRANJAS:\n        if inicio &lt;= hora &lt;= fin:\n            return nombre\n    return None\n\n\ndf["Fecha y hora de publicación"] = local\ndf["Hora de publicación"] = local.dt.hour\n\n# Día y franja se guardan como categorías ordenadas, para que Orange las trate\n# como variables discretas y las muestre en orden cronológico y no alfabético.\ndia = local.dt.dayofweek.map(lambda d: None if pd.isna(d) else DIAS[int(d)])\ndf["Día de la semana"] = pd.Categorical(dia, categories=DIAS, ordered=True)\nfranja = df["Hora de publicación"].map(franja_de)\ndf["Franja horaria"] = pd.Categorical(franja, categories=[f[2] for f in FRANJAS], ordered=True)\n\n# "Fecha y hora de publicación" se pone primero: así Table to Time Series la\n# propone por defecto (si no, elegiría \'Fecha\', que no trae la hora).\norden = ["Fecha y hora de publicación"] + [c for c in df.columns if c != "Fecha y hora de publicación"]\ndf = df[orden]\n\nprint(f"Publicaciones procesadas: {len(df)}")\nif local.notna().any():\n    print(f"Primera: {local.min()}   Última: {local.max()}   (hora de {ZONA_HORARIA})")\n\n# Revisión rápida: la columna \'Fecha\' que exporta X debería coincidir con la\n# fecha local que acabo de calcular. Si no coincide, X está exportando \'Fecha\'\n# en otra zona horaria (normalmente UTC) y conviene usar la calculada.\nif "Fecha" in df.columns:\n    fecha_x = pd.to_datetime(df["Fecha"], errors="coerce").dt.normalize()\n    comparables = fecha_x.notna() &amp; local.notna()\n    difieren = int((fecha_x[comparables] != local[comparables].dt.normalize()).sum())\n    print(f"Fecha exportada por X vs. fecha decodificada: "\n          f"{difieren} de {int(comparables.sum())} difieren.")\n\nout_data = table_from_frame(df)', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# ============================ CONFIGURACIÓN ============================\nZONA_HORARIA = "America/Mexico_City"\n# Franjas horarias en hora local (0 a 23). Cada una es (hora_inicio, hora_fin, nombre).\n\nFRANJAS = [\n    (0, 5, "Madrugada (0-5 h)"),\n    (6, 11, "Mañana (6-11 h)"),\n    (12, 17, "Tarde (12-17 h)"),\n    (18, 23, "Noche (18-23 h)"),\n]\n# =======================================================================\n\n# Evita reenviar la tabla de una corrida anterior si esta falla a la mitad.\nout_data = None\n\nif in_data is None or len(in_data) == 0:\n    raise ValueError("Conecta la salida de \'PUB-03 Quitar respuestas (@)\' a este widget.")\n\ndf = table_to_frame(in_data, include_metas=True)\nfor col in df.columns:\n    if str(df[col].dtype) == "category":\n        df[col] = df[col].astype(object)\n\nif "ID del post" not in df.columns:\n    raise ValueError("No encuentro la columna \'ID del post\'.")\n\n# Los IDs de X son tipo "Snowflake": los bits altos (id &gt;&gt; 22) son los\n# milisegundos que pasaron desde el 4 de noviembre de 2010 (la época de\n# Twitter). Con eso se recupera el momento exacto de la publicación, en UTC.\nEPOCA_TWITTER_MS = 1288834974657\n\n\ndef milisegundos(valor):\n    try:\n        return (int(str(valor).strip()) &gt;&gt; 22) + EPOCA_TWITTER_MS\n    except (ValueError, TypeError):\n        return None\n\n\nms = df["ID del post"].apply(milisegundos)\nutc = pd.to_datetime(ms.astype("float64"), unit="ms", utc=True)\n\ntry:\n    local = utc.dt.tz_convert(ZONA_HORARIA).dt.tz_localize(None)\nexcept Exception:\n    # Si el equipo no tiene la base de zonas horarias, uso UTC-6 fijo (México\n    # no tiene horario de verano desde 2022).\n    print(f"AVISO: no se pudo cargar la zona \'{ZONA_HORARIA}\'; se usó UTC-6 fijo.")\n    local = (utc - pd.Timedelta(hours=6)).dt.tz_localize(None)\n\nsin_hora = int(local.isna().sum())\nif sin_hora:\n    print(f"AVISO: {sin_hora} publicaciones con ID no decodificable; "\n          f"su hora quedó vacía.")\n\nDIAS = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"]\n\n\ndef franja_de(hora):\n    if pd.isna(hora):\n        return None\n    for inicio, fin, nombre in FRANJAS:\n        if inicio &lt;= hora &lt;= fin:\n            return nombre\n    return None\n\n\ndf["Fecha y hora de publicación"] = local\ndf["Hora de publicación"] = local.dt.hour\n\n# Día y franja se guardan como categorías ordenadas, para que Orange las trate\n# como variables discretas y las muestre en orden cronológico y no alfabético.\ndia = local.dt.dayofweek.map(lambda d: None if pd.isna(d) else DIAS[int(d)])\ndf["Día de la semana"] = pd.Categorical(dia, categories=DIAS, ordered=True)\nfranja = df["Hora de publicación"].map(franja_de)\ndf["Franja horaria"] = pd.Categorical(franja, categories=[f[2] for f in FRANJAS], ordered=True)\n\n# "Fecha y hora de publicación" se pone primero: así Table to Time Series la\n# propone por defecto (si no, elegiría \'Fecha\', que no trae la hora).\norden = ["Fecha y hora de publicación"] + [c for c in df.columns if c != "Fecha y hora de publicación"]\ndf = df[orden]\n\nprint(f"Publicaciones procesadas: {len(df)}")\nif local.notna().any():\n    print(f"Primera: {local.min()}   Última: {local.max()}   (hora de {ZONA_HORARIA})")\n\n# Revisión rápida: la columna \'Fecha\' que exporta X debería coincidir con la\n# fecha local que acabo de calcular. Si no coincide, X está exportando \'Fecha\'\n# en otra zona horaria (normalmente UTC) y conviene usar la calculada.\nif "Fecha" in df.columns:\n    fecha_x = pd.to_datetime(df["Fecha"], errors="coerce").dt.normalize()\n    comparables = fecha_x.notna() &amp; local.notna()\n    difieren = int((fecha_x[comparables] != local[comparables].dt.normalize()).sum())\n    print(f"Fecha exportada por X vs. fecha decodificada: "\n          f"{difieren} de {int(comparables.sum())} difieren.")\n\nout_data = table_from_frame(df)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
