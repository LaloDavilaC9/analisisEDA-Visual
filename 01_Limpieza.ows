		<properties node_id="18" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Suma una columna de la tabla conectada. Si quieres sumar otra, cámbiala aquí.\nCOLUMNA = "Total Earnings"\n\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\nif in_data is None:\n    raise ValueError("Conecta una tabla a este widget.")\n\ndf = table_to_frame(in_data, include_metas=True)\nif COLUMNA not in df.columns:\n    raise ValueError(f"La tabla no tiene la columna \'{COLUMNA}\'. Columnas: {list(df.columns)}")\n\ncol = df[COLUMNA]\nif str(col.dtype) == "category":\n    col = col.astype(object)\nif pd.api.types.is_numeric_dtype(col):\n    valores = pd.to_numeric(col, errors="coerce")\nelse:\n    # Si Orange la leyó como texto, le quito comas, $ y espacios y la convierto.\n    valores = pd.to_numeric(col.astype(str).str.replace(r"[,$\\s]", "", regex=True), errors="coerce")\n\nn_filas = len(df)\nn_con_valor = int(valores.notna().sum())\nsuma = float(valores.sum())\n\nprint(f"Filas en la tabla: {n_filas}")\nprint(f"Filas con valor numérico en \'{COLUMNA}\': {n_con_valor}"\n      + (f" ({n_filas - n_con_valor} sin valor o no numérico, no se suman)" if n_con_valor &lt; n_filas else ""))\nprint(f"Suma de \'{COLUMNA}\': {suma:,.2f}")\n\nout_data = table_from_frame(pd.DataFrame({\n    "Filas": [n_filas],\n    "Filas con valor": [n_con_valor],\n    f"{COLUMNA} (suma)": [suma],\n}))', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Suma una columna de la tabla conectada. Si quieres sumar otra, cámbiala aquí.\nCOLUMNA = "Total Earnings"\n\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\nif in_data is None:\n    raise ValueError("Conecta una tabla a este widget.")\n\ndf = table_to_frame(in_data, include_metas=True)\nif COLUMNA not in df.columns:\n    raise ValueError(f"La tabla no tiene la columna \'{COLUMNA}\'. Columnas: {list(df.columns)}")\n\ncol = df[COLUMNA]\nif str(col.dtype) == "category":\n    col = col.astype(object)\nif pd.api.types.is_numeric_dtype(col):\n    valores = pd.to_numeric(col, errors="coerce")\nelse:\n    # Si Orange la leyó como texto, le quito comas, $ y espacios y la convierto.\n    valores = pd.to_numeric(col.astype(str).str.replace(r"[,$\\s]", "", regex=True), errors="coerce")\n\nn_filas = len(df)\nn_con_valor = int(valores.notna().sum())\nsuma = float(valores.sum())\n\nprint(f"Filas en la tabla: {n_filas}")\nprint(f"Filas con valor numérico en \'{COLUMNA}\': {n_con_valor}"\n      + (f" ({n_filas - n_con_valor} sin valor o no numérico, no se suman)" if n_con_valor &lt; n_filas else ""))\nprint(f"Suma de \'{COLUMNA}\': {suma:,.2f}")\n\nout_data = table_from_frame(pd.DataFrame({\n    "Filas": [n_filas],\n    "Filas con valor": [n_con_valor],\n    f"{COLUMNA} (suma)": [suma],\n}))', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="19" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'scriptLibrary': [{'name': 'Script', 'script': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Reparte la comisión (Total Earnings) en cuatro partes que, juntas, suman el\n# total de Ventas:\n#   1. Enlaces genéricos (a tiendas o listas, sin un producto puntual). No\n#      están en el resumen, pero su comisión sí cuenta en el total de Ventas.\n#   2. Productos con el título repetido en Ventas (no se les pueden asociar\n#      publicaciones).\n#   3. Productos con publicaciones identificadas (N publicaciones &gt; 0).\n#   4. Productos sin publicaciones identificadas (N publicaciones = 0).\n#\n# Recibe dos tablas, en cualquier orden:\n#   - las ventas limpias, las mismas que entran a \'INT-03 Resumen por producto\'\n#   - la salida completa de \'INT-03 Resumen por producto\' (sin filtrar)\n# No modifica nada: solo suma y compara. Avisa si las dos tablas no cuadran.\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nresumen = next((t for t in tablas\n                if {"N publicaciones", "Título repetido en Ventas"} &lt;= nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "N publicaciones" not in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\nif ventas is None or resumen is None:\n    raise ValueError(\n        "Conecta las dos tablas: Ventas limpio (con \'Product Title\') y la salida de "\n        "\'INT-03 Resumen por producto\' (con \'N publicaciones\').")\n\ndf_v = table_to_frame(ventas, include_metas=True)\ndf_r = table_to_frame(resumen, include_metas=True)\nfor df in (df_v, df_r):\n    for col in df.columns:\n        if str(df[col].dtype) == "category":\n            df[col] = df[col].astype(object)\n    if "Total Earnings" not in df.columns:\n        raise ValueError("Falta la columna \'Total Earnings\' en una de las dos tablas.")\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\ndef a_numero(valor):\n    try:\n        x = float(str(valor).replace(",", "").replace("$", "").strip())\n    except (ValueError, TypeError):\n        return 0.0\n    return 0.0 if x != x else x\n\n\n# Mismo criterio de "genérico" que usa \'INT-03 Resumen por producto\'.\nif "es_generico" in df_v.columns:\n    es_gen = df_v["es_generico"].apply(es_verdadero)\nelse:\n    es_gen = df_v["Product Title"].apply(es_valor_centinela)\n\ncom_v = df_v["Total Earnings"].apply(a_numero)\ncom_r = df_r["Total Earnings"].apply(a_numero)\nrepetido = df_r["Título repetido en Ventas"].astype(str).eq("Sí")\nn_pub = df_r["N publicaciones"].apply(a_numero)\ncon_pub = (~repetido) &amp; (n_pub &gt; 0)\nsin_pub = (~repetido) &amp; (n_pub &lt;= 0)\n\ngrupos = [\n    ("Enlaces genéricos (sin producto)", int(es_gen.sum()), float(com_v[es_gen].sum())),\n    ("Títulos repetidos en Ventas", int(repetido.sum()), float(com_r[repetido].sum())),\n    ("Productos con publicaciones identificadas", int(con_pub.sum()), float(com_r[con_pub].sum())),\n    ("Productos sin publicaciones identificadas", int(sin_pub.sum()), float(com_r[sin_pub].sum())),\n]\ntotal_ventas = float(com_v.sum())\nsuma_grupos = sum(g[2] for g in grupos)\nfilas_ventas = len(df_v)\n\nfilas = [(nombre, n, monto, (100 * monto / total_ventas) if total_ventas else float("nan"))\n         for nombre, n, monto in grupos]\nfilas.append(("TOTAL (Ventas)", filas_ventas, total_ventas, 100.0 if total_ventas else float("nan")))\n\n# ------------------------------- Informe -----------------------------------\nprint(f"Total Earnings de Ventas: {total_ventas:,.2f} ({filas_ventas} filas)")\nfor nombre, n, monto, pct in filas[:-1]:\n    print(f"   {nombre:&lt;44} {n:&gt;4} filas  {monto:&gt;12,.2f}  ({pct:.1f} %)")\nif len(df_r) + int(es_gen.sum()) != filas_ventas:\n    print(f"AVISO: el resumen tiene {len(df_r)} filas y Ventas {filas_ventas} con {int(es_gen.sum())} genéricas; "\n          f"no cuadran. ¿El resumen está filtrado o viene de otra corrida? Conecta la salida completa de "\n          f"\'INT-03 Resumen por producto\'.")\nelif abs(suma_grupos - total_ventas) &gt; 0.005:\n    print(f"AVISO: las cuatro partes suman {suma_grupos:,.2f} y Ventas {total_ventas:,.2f} "\n          f"(diferencia {total_ventas - suma_grupos:,.2f}); revisa que las dos tablas sean de la misma corrida.")\nelse:\n    print("Cuadra: las cuatro partes suman exactamente el total de Ventas.")\n\nout_data = table_from_frame(pd.DataFrame({\n    "Grupo": [f[0] for f in filas],\n    "Filas": [f[1] for f in filas],\n    "Total Earnings": [round(f[2], 2) for f in filas],\n    "% del total": [round(f[3], 2) for f in filas],\n}))\n', 'filename': None}], 'scriptText': 'import pandas as pd\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# Reparte la comisión (Total Earnings) en cuatro partes que, juntas, suman el\n# total de Ventas:\n#   1. Enlaces genéricos (a tiendas o listas, sin un producto puntual). No\n#      están en el resumen, pero su comisión sí cuenta en el total de Ventas.\n#   2. Productos con el título repetido en Ventas (no se les pueden asociar\n#      publicaciones).\n#   3. Productos con publicaciones identificadas (N publicaciones &gt; 0).\n#   4. Productos sin publicaciones identificadas (N publicaciones = 0).\n#\n# Recibe dos tablas, en cualquier orden:\n#   - las ventas limpias, las mismas que entran a \'INT-03 Resumen por producto\'\n#   - la salida completa de \'INT-03 Resumen por producto\' (sin filtrar)\n# No modifica nada: solo suma y compara. Avisa si las dos tablas no cuadran.\nout_data = None  # evita reenviar la tabla de una corrida anterior si esta falla\n\ntablas = [t for t in in_datas if t is not None and len(t) &gt; 0]\n\n\ndef nombres_columnas(tabla):\n    return {v.name for v in list(tabla.domain.variables) + list(tabla.domain.metas)}\n\n\nresumen = next((t for t in tablas\n                if {"N publicaciones", "Título repetido en Ventas"} &lt;= nombres_columnas(t)), None)\nventas = next((t for t in tablas\n               if "Product Title" in nombres_columnas(t)\n               and "N publicaciones" not in nombres_columnas(t)\n               and "Texto del post" not in nombres_columnas(t)), None)\nif ventas is None or resumen is None:\n    raise ValueError(\n        "Conecta las dos tablas: Ventas limpio (con \'Product Title\') y la salida de "\n        "\'INT-03 Resumen por producto\' (con \'N publicaciones\').")\n\ndf_v = table_to_frame(ventas, include_metas=True)\ndf_r = table_to_frame(resumen, include_metas=True)\nfor df in (df_v, df_r):\n    for col in df.columns:\n        if str(df[col].dtype) == "category":\n            df[col] = df[col].astype(object)\n    if "Total Earnings" not in df.columns:\n        raise ValueError("Falta la columna \'Total Earnings\' en una de las dos tablas.")\n\nSENTINEL_VALUES = {"unknown", "none", "other", "others", "n/a", "na", "-", ""}\n\n\ndef es_valor_centinela(valor):\n    return str(valor).strip().lower() in SENTINEL_VALUES\n\n\ndef es_verdadero(valor):\n    if isinstance(valor, str):\n        return valor.strip().lower() in {"1", "1.0", "true", "si", "sí", "yes"}\n    try:\n        return (not pd.isna(valor)) and bool(valor)\n    except (TypeError, ValueError):\n        return False\n\n\ndef a_numero(valor):\n    try:\n        x = float(str(valor).replace(",", "").replace("$", "").strip())\n    except (ValueError, TypeError):\n        return 0.0\n    return 0.0 if x != x else x\n\n\n# Mismo criterio de "genérico" que usa \'INT-03 Resumen por producto\'.\nif "es_generico" in df_v.columns:\n    es_gen = df_v["es_generico"].apply(es_verdadero)\nelse:\n    es_gen = df_v["Product Title"].apply(es_valor_centinela)\n\ncom_v = df_v["Total Earnings"].apply(a_numero)\ncom_r = df_r["Total Earnings"].apply(a_numero)\nrepetido = df_r["Título repetido en Ventas"].astype(str).eq("Sí")\nn_pub = df_r["N publicaciones"].apply(a_numero)\ncon_pub = (~repetido) &amp; (n_pub &gt; 0)\nsin_pub = (~repetido) &amp; (n_pub &lt;= 0)\n\ngrupos = [\n    ("Enlaces genéricos (sin producto)", int(es_gen.sum()), float(com_v[es_gen].sum())),\n    ("Títulos repetidos en Ventas", int(repetido.sum()), float(com_r[repetido].sum())),\n    ("Productos con publicaciones identificadas", int(con_pub.sum()), float(com_r[con_pub].sum())),\n    ("Productos sin publicaciones identificadas", int(sin_pub.sum()), float(com_r[sin_pub].sum())),\n]\ntotal_ventas = float(com_v.sum())\nsuma_grupos = sum(g[2] for g in grupos)\nfilas_ventas = len(df_v)\n\nfilas = [(nombre, n, monto, (100 * monto / total_ventas) if total_ventas else float("nan"))\n         for nombre, n, monto in grupos]\nfilas.append(("TOTAL (Ventas)", filas_ventas, total_ventas, 100.0 if total_ventas else float("nan")))\n\n# ------------------------------- Informe -----------------------------------\nprint(f"Total Earnings de Ventas: {total_ventas:,.2f} ({filas_ventas} filas)")\nfor nombre, n, monto, pct in filas[:-1]:\n    print(f"   {nombre:&lt;44} {n:&gt;4} filas  {monto:&gt;12,.2f}  ({pct:.1f} %)")\nif len(df_r) + int(es_gen.sum()) != filas_ventas:\n    print(f"AVISO: el resumen tiene {len(df_r)} filas y Ventas {filas_ventas} con {int(es_gen.sum())} genéricas; "\n          f"no cuadran. ¿El resumen está filtrado o viene de otra corrida? Conecta la salida completa de "\n          f"\'INT-03 Resumen por producto\'.")\nelif abs(suma_grupos - total_ventas) &gt; 0.005:\n    print(f"AVISO: las cuatro partes suman {suma_grupos:,.2f} y Ventas {total_ventas:,.2f} "\n          f"(diferencia {total_ventas - suma_grupos:,.2f}); revisa que las dos tablas sean de la misma corrida.")\nelse:\n    print("Cuadra: las cuatro partes suman exactamente el total de Ventas.")\n\nout_data = table_from_frame(pd.DataFrame({\n    "Grupo": [f[0] for f in filas],\n    "Filas": [f[1] for f in filas],\n    "Total Earnings": [round(f[2], 2) for f in filas],\n    "% del total": [round(f[3], 2) for f in filas],\n}))\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
